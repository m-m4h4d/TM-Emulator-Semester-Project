{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.png",
      "use": "@vercel/static"
    },
    {
      "src": "apple-touch-icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "api/tm_core.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/tm_core",
      "dest": "api/tm_core.py"
    },
    {
      "src": "/(favicon\\.ico|favicon\\.png|apple-touch-icon\\.png)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
